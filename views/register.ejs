<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>REGISTER</title>
</head>
<body class="w-full h-screen items-center justify-center flex bg-gradient-to-b from-blue-200 to-indigo-500

">
    <div class="shadow-2xl m-3 p-20">
        <div class="text-center font-bold text-blue-700 text-4xl">
        <h2>JUAN PORTOFOLIO</h2>
        </div>
    <h1 class="font-bold text-center text-3xl text-blue-700 mb-9">REGISTER</h1>
    <form action="/register" method="post">
    <div class="mb-2 font-bold">
        <label for="username">username</label>
        <input class="border-2 border-black rounded-lg px-2 py-1" type="text" name="username" id="username" placeholder="masukan username" required>
    </div>
        <div class="mb-2 font-bold">
            <label for="password">password</label>
            <input class="border-2 border-black rounded-lg px-2 py-1" type="password" name="password" id="password" placeholder="masukan password" required>
        </div>
            <div class="text-center mt-7 text-xl font-bold bg-blue-600 rounded-md px-2 py-1">
                <button type="submit">SUBMIT</button>
            </div>
    </form>
    </div>  
</body>
</html>